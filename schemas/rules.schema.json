{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market_window_days",
    "elsewhere_window_days",
    "min_market_sightings",
    "real_deal_pct",
    "pricier_pct",
    "elsewhere_margin_pct",
    "default_expiry_days",
    "badge_tolerance_pct",
    "max_image_kb",
    "max_product_image_kb"
  ],
  "properties": {
    "market_window_days": {
      "type": "integer",
      "minimum": 1
    },
    "elsewhere_window_days": {
      "type": "integer",
      "minimum": 1
    },
    "min_market_sightings": {
      "type": "integer",
      "minimum": 1
    },
    "real_deal_pct": {
      "type": "integer",
      "minimum": 1
    },
    "pricier_pct": {
      "type": "integer",
      "minimum": 1
    },
    "elsewhere_margin_pct": {
      "type": "integer",
      "minimum": 1
    },
    "default_expiry_days": {
      "type": "integer",
      "minimum": 1
    },
    "badge_tolerance_pct": {
      "type": "integer",
      "minimum": 1
    },
    "max_image_kb": {
      "type": "integer",
      "minimum": 1
    },
    "max_product_image_kb": {
      "type": "integer",
      "minimum": 1
    }
  }
}
