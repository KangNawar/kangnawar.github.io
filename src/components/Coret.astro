---
// Wraps text with a hand-drawn red strike. `draw` animates it once (hero only).
interface Props { draw?: boolean; weight?: number }
const { draw = false, weight = 5 } = Astro.props;
---
<span class:list={['coret', { 'coret-draw': draw }]}>
  <slot />
  <svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M3 30 C 22 26, 40 19, 58 15 S 88 8, 97 6" stroke-width={weight} vector-effect="non-scaling-stroke" />
  </svg>
</span>
