---
import type { Sighting } from '../lib/data';
import { db } from '../lib/data';
import { rupiah, pct, rentang, ukuran, satuan, productName } from '../lib/format';
import Verdict from './Verdict.astro';
import Thumb from './Thumb.astro';

interface Props { s: Sighting; showStore?: boolean }
const { s, showStore = true } = Astro.props;
const p = s.productData;
const raw = s.raw;
const qty = raw.quantity ?? 1;
const unit = satuan(s.unit_label);
const conditions: string[] = [];
if (raw.promo?.member_only) conditions.push('Khusus member');
if (raw.promo?.min_purchase) conditions.push(`Min. belanja ${rupiah(raw.promo.min_purchase)}`);
if (raw.promo?.type === 'hadiah' && raw.promo.label) conditions.push(raw.promo.label);
const basis = raw.price_basis
  ? `per ${raw.price_basis.amount === 1000 ? '1' : raw.price_basis.amount} ${raw.price_basis.amount === 1000 && raw.price_basis.unit === 'g' ? 'kg' : raw.price_basis.unit}`
  : qty > 1 ? `untuk ${qty}` : '';
const cheaper = s.cheaper_elsewhere;
const cheaperStore = cheaper ? db().storeMap.get(cheaper.store)?.name : null;
const showVerdict = !['belum-ada-pembanding', 'harga-reguler', 'lebih-murah-di-tempat-lain'].includes(s.verdict);
---
<li
  class="grid grid-cols-[auto_1fr_auto] gap-x-3 sm:gap-x-4 py-5 border-b border-line"
  data-cat={p.category}
  data-sub={p.subcategory}
  data-market={s.vs_market_pct ?? -999}
  data-claimed={s.claimed_discount_pct ?? -999}
  data-unit={s.unit_price}
  data-unitlabel={s.unit_label}
  data-expires={s.expires_on ?? '9999'}
  data-seen={s.seen_on}
>
  <Thumb p={p} />
  <div class="min-w-0">
    <a href={`/produk/${p.id}/`} class="font-semibold text-[1.0625rem] leading-snug hover:underline">
      {productName(p)}
    </a>
    <p class="text-slate text-[0.9375rem] mt-0.5">
      {ukuran(p)}{p.variant && <span>, {p.variant.toLowerCase().startsWith('semua') ? p.variant.toLowerCase() : p.variant}</span>}
    </p>
    <p class="text-[0.9375rem] mt-1">
      {showStore && <a href={`/toko/${s.store}/`} class="hover:underline">{s.storeData.name}</a>}
      {showStore && raw.channel === 'online' && <span> (online)</span>}
      {raw.valid_until && <span class="text-slate">{showStore ? ', ' : ''}{rentang(raw.valid_from, raw.valid_until)}</span>}
    </p>
    {conditions.length > 0 && <p class="text-[0.875rem] text-slate mt-1">{conditions.join('. ')}</p>}
    {cheaper && (
      <p class="mt-2 leading-tight">
        <a href={`/produk/${p.id}/`} class="catatan text-[1.1875rem] hover:underline">
          di {cheaperStore} {rupiah(cheaper.unit_price)}{unit}, hemat {pct(cheaper.saving_pct)}
        </a>
      </p>
    )}
    {showVerdict && <p class="mt-2"><Verdict verdict={s.verdict} label={s.verdict_label} /></p>}
  </div>
  <div class="text-right angka">
    <p class="text-[1.375rem] font-bold leading-tight"><span class="harga">{rupiah(raw.price)}</span></p>
    {basis && <p class="text-[0.8125rem] text-slate">{basis}</p>}
    {raw.claimed_normal_price && (
      <p class="text-[0.9375rem] text-slate line-through decoration-slate/70">{rupiah(raw.claimed_normal_price * (raw.price_basis ? 1 : qty))}</p>
    )}
    {s.claimed_discount_pct !== null && s.claimed_discount_pct > 0 && (
      <p class="text-[0.875rem]">diskon {pct(s.claimed_discount_pct)}</p>
    )}
    {(!raw.price_basis || p.loose) && <p class="text-[0.8125rem] text-slate mt-1">{rupiah(s.unit_price)}{unit}</p>}
  </div>
</li>
