---
interface Props { verdict: string; label: string }
const { verdict, label } = Astro.props;
const tone: Record<string, string> = {
  'lebih-murah-di-tempat-lain': 'border border-pen text-pen',
  'hemat-beneran': 'bg-hemat text-paper',
  'sesuai-harga-pasar': 'border border-line text-slate',
  'di-atas-harga-pasar': 'border border-line text-ink',
};
const quiet = !(verdict in tone);
---
<span class:list={['inline-flex items-center rounded-full text-[0.8125rem] leading-none whitespace-nowrap', quiet ? 'text-slate py-1' : 'px-2.5 py-1.5 font-semibold', tone[verdict]]}>
  {label}
</span>
