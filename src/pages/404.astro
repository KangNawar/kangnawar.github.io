---
import Base from '../layouts/Base.astro';
---
<Base title="Halaman tidak ada">
  <div class="mt-16 max-w-prose">
    <h1 class="text-[2.25rem] font-extrabold tracking-tight">Halaman ini tidak ada.</h1>
    <p class="mt-3 text-[1.125rem]">Mungkin promonya sudah berakhir, atau alamatnya salah ketik.</p>
    <p class="mt-6 flex flex-wrap gap-3">
      <a href="/" class="rounded-full bg-ink text-paper px-5 py-2.5 font-semibold">Lihat promo yang berlaku</a>
      <a href="/cari/" class="rounded-full border border-ink px-5 py-2.5 font-semibold">Cari produk</a>
    </p>
  </div>
</Base>
