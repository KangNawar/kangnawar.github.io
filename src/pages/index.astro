---
import Base from '../layouts/Base.astro';
import PriceRow from '../components/PriceRow.astro';
import { activePromos, db, rankedDeals } from '../lib/data';
import { rupiah, pct, rentang, productName, tanggal, satuan } from '../lib/format';
import { TOP_DEALS } from '../lib/site';
import fs from 'node:fs';

const promos = activePromos();
const { generatedOn, products, storeMap } = db();
const cheaper = promos
  .filter((s) => s.cheaper_elsewhere)
  .sort((a, b) => b.cheaper_elsewhere!.saving_pct - a.cheaper_elsewhere!.saving_pct);
const hero = cheaper[0];
const heroOther = hero ? storeMap.get(hero.cheaper_elsewhere!.store)! : null;
const heroUnit = hero ? satuan(hero.unit_label) : '';
const stores = new Set(promos.map((s) => s.store));
const rules = JSON.parse(fs.readFileSync('data/rules.json', 'utf-8'));
// A few spare rows so the list still shows TOP_DEALS after some promos expire between rebuilds.
const deals = rankedDeals(promos).slice(0, TOP_DEALS * 2);
const realDeals = deals.filter((s) => s.verdict === 'hemat-beneran').length;
---
<Base wide>
  <section class="pt-10 pb-12 sm:pt-16 sm:pb-16 grid gap-x-10 gap-y-6 md:grid-cols-[1.1fr_1fr]">
    <h1 class="md:col-start-2 md:row-start-1 self-end text-[2.25rem] sm:text-[3rem] font-extrabold leading-[1.05] tracking-tight text-balance">
      Cek dulu, mungkin ada yang lebih murah.
    </h1>
    {hero ? (
      <figure class="md:col-start-1 md:row-start-1 md:row-span-2 relative" aria-label={`${productName(hero.productData)} di ${hero.storeData.name} ${rupiah(hero.unit_price)}${heroUnit}; di ${heroOther!.name} ${rupiah(hero.cheaper_elsewhere!.unit_price)}${heroUnit}`}>
        <div class="relative inline-block rounded-2xl bg-tag text-on-tag px-6 py-5 sm:px-8 sm:py-7 -rotate-1 shadow-[6px_6px_0_var(--shadow)]">
          <p class="text-[1.0625rem] sm:text-[1.25rem] font-semibold">{productName(hero.productData)}, {hero.storeData.name}</p>
          <p class="text-[3.75rem] sm:text-[5.75rem] font-extrabold leading-[0.95] tracking-tight angka">{rupiah(hero.unit_price)}</p>
          <p class="text-[1rem] sm:text-[1.125rem]">{hero.unit_label}, promo {rentang(hero.raw.valid_from, hero.raw.valid_until)}</p>
        </div>
        <div class="flex items-end gap-1 mt-2 ml-6 sm:ml-16">
          <svg class="panah panah-draw shrink-0" width="64" height="58" viewBox="0 0 64 58" aria-hidden="true">
            <path d="M6 4 C 4 26, 18 44, 52 48" /><path d="M42 39 L 53 48 L 41 55" />
          </svg>
          <p class="tulis-draw catatan text-[2rem] sm:text-[2.5rem] leading-none pb-1">
            di {heroOther!.name} {rupiah(hero.cheaper_elsewhere!.unit_price)}
          </p>
        </div>
      </figure>
    ) : (
      <div class="md:col-start-1 md:row-start-1 md:row-span-2" />
    )}
    <div class="md:col-start-2 md:row-start-2 self-start">
      {hero && (
        <p class="text-[1.125rem] max-w-[36ch]">
          {productName(hero.productData)} lagi promo di {hero.storeData.name}, {rupiah(hero.unit_price)} {hero.unit_label}.
          Di {heroOther!.name} harganya {rupiah(hero.cheaper_elsewhere!.unit_price)}, {pct(hero.cheaper_elsewhere!.saving_pct)} lebih murah.
        </p>
      )}
      <p class="mt-4 text-slate max-w-[44ch]">
        Kang Nawar membandingkan harga promo dengan harga produk yang sama di toko lain, per kg, per 100 ml atau per buah,
        supaya kamu tahu di mana belanja paling hemat.
      </p>
    </div>
  </section>

  <section aria-labelledby="teratas">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="teratas" class="text-[1.5rem] font-bold tracking-tight">{TOP_DEALS} promo teratas</h2>
      <p class="text-slate text-[0.9375rem]">diperbarui {tanggal(generatedOn, true)}</p>
    </div>
    <p class="text-slate mt-1 max-w-prose">
      {realDeals > 0
        ? `Yang hemat beneran duluan: minimal ${rules.real_deal_pct}% di bawah harga produk yang sama di toko lain. Setelah itu promo dengan diskon terbesar.`
        : `Belum ada promo yang terbukti hemat beneran (minimal ${rules.real_deal_pct}% di bawah harga toko lain), jadi ini promo dengan diskon toko terbesar. Perbandingannya menyusul begitu ada harga dari toko lain.`}
    </p>
    <ul class="mt-3 border-t-2 border-ink" id="teratas-daftar" data-max={TOP_DEALS}>
      {deals.map((s) => <PriceRow s={s} />)}
    </ul>
    <style is:inline set:html={`#teratas-daftar:not(.siap)>li:nth-child(n+${TOP_DEALS + 1}){display:none}`}></style>
    <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="/promo/" class="inline-flex items-center gap-2 rounded-full bg-ink text-paper px-5 py-2.5 font-semibold hover:opacity-90">
        Lihat semua {promos.length} promo
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="/kategori/" class="underline">Pilih per kategori</a>
    </p>
    <p class="text-slate mt-6 max-w-prose text-[0.9375rem]">
      {promos.length} promo dari {stores.size} toko.
      Harga dari toko lain membuat perbandingannya jalan. <a href="/panduan/" class="underline">Bantu tambah harga</a>.
    </p>
  </section>
</Base>

<script>
  // Show the first N promos that haven't ended yet (the site is only rebuilt by hand).
  const list = document.getElementById('teratas-daftar');
  if (list) {
    const max = Number(list.dataset.max);
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    let shown = 0;
    for (const row of Array.from(list.children) as HTMLElement[]) {
      const live = (row.dataset.expires ?? '9999') >= today;
      row.hidden = !live || shown >= max;
      if (!row.hidden) shown++;
    }
    list.classList.add('siap');
  }
</script>
