---
import Base from '../../layouts/Base.astro';
import { db, activePromos } from '../../lib/data';
const { activeCategories } = db();
const promos = activePromos();
const productsIn = (id: string) => [...db().products.values()].filter((p) => p.category === id).length;
---
<Base title="Kategori" description="Semua kategori produk yang dicatat Kang Nawar.">
  <h1 class="text-[2.25rem] font-extrabold tracking-tight leading-tight mt-10">Kategori</h1>
  <ul class="mt-6 border-t-2 border-ink">
    {activeCategories.map((c) => {
      const n = promos.filter((s) => s.productData.category === c.id).length;
      const p = productsIn(c.id);
      return (
        <li class="border-b border-line">
          <a href={`/kategori/${c.id}/`} class="flex items-baseline justify-between gap-4 py-4 group">
            <span>
              <span class="text-[1.25rem] font-semibold group-hover:underline">{c.name}</span>
              <span class="block text-slate text-[0.9375rem]">{c.subcategories.map((s) => s.name).join(', ')}</span>
            </span>
            <span class="text-right text-[0.9375rem] whitespace-nowrap">{n > 0 ? `${n} promo` : p > 0 ? `${p} produk` : 'Belum ada data'}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
