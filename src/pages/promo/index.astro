---
import Base from '../../layouts/Base.astro';
import PromoList from '../../components/PromoList.astro';
import Thumb from '../../components/Thumb.astro';
import { activePromos, db } from '../../lib/data';
import { rupiah, productName, tanggal, satuan, ukuran } from '../../lib/format';

const promos = activePromos();
const { generatedOn, storeMap } = db();
const stores = new Set(promos.map((s) => s.store));
const compared = promos.filter((s) => s.market_count > 0).length;
const cheaper = promos
  .filter((s) => s.cheaper_elsewhere)
  .sort((a, b) => b.cheaper_elsewhere!.saving_pct - a.cheaper_elsewhere!.saving_pct);
---
<Base title="Semua promo" description="Semua promo yang sedang berlaku, dibandingkan dengan harga di toko lain." wide>
  <nav aria-label="Jejak" class="mt-8 text-[0.9375rem] text-slate"><a href="/kategori/" class="hover:underline">Kategori</a></nav>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mt-1">
    <h1 class="text-[2.25rem] font-extrabold tracking-tight leading-tight">Semua promo</h1>
    <p class="text-slate text-[0.9375rem]">{promos.length} promo dari {stores.size} toko, diperbarui {tanggal(generatedOn, true)}</p>
  </div>
  <p class="text-slate mt-1 mb-6 max-w-prose">
    {compared} dari {promos.length} promo sudah punya harga pembanding dari toko lain.
    Sisanya baru dari satu katalog, jadi belum bisa dibandingkan. <a href="/panduan/" class="underline">Bantu tambah harga</a>.
  </p>

  {cheaper.length > 0 && (
    <section aria-labelledby="lebih-murah" class="mb-10">
      <h2 id="lebih-murah" class="text-[1.25rem] font-bold tracking-tight">Ada yang lebih murah di toko lain</h2>
      <p class="text-slate mt-1 max-w-prose">Lagi promo, tapi produk yang sama tercatat lebih murah di toko lain dalam 2 minggu terakhir.</p>
      <ul class="mt-4 grid gap-4 grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))]">
        {cheaper.slice(0, 6).map((s) => {
          const other = storeMap.get(s.cheaper_elsewhere!.store)!;
          const unit = satuan(s.unit_label);
          return (
            <li class="rounded-2xl border border-line p-4 flex gap-3">
              <Thumb p={s.productData} />
              <div class="min-w-0">
                <a href={`/produk/${s.product}/`} class="font-semibold leading-snug hover:underline">{productName(s.productData)}</a>
                <p class="text-slate text-[0.9375rem]">{ukuran(s.productData)}</p>
                <p class="mt-2 text-[0.9375rem] angka">{s.storeData.name}, promo: <span class="harga font-semibold">{rupiah(s.unit_price)}{unit}</span></p>
                <p class="catatan text-[1.25rem] mt-1">di {other.name} {rupiah(s.cheaper_elsewhere!.unit_price)}{unit}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <PromoList items={promos} />
</Base>
